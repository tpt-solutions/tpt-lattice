{
  "name": "tpt-lattice-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SolidJS + Canvas UI for the TPT Lattice spreadsheet engine, talking to the wasm engine over a Web Worker.",
  "scripts": {
    "wasm": "wasm-pack build ../crates/tpt-lattice-wasm --target web --out-dir ../crates/tpt-lattice-wasm/pkg",
    "predev": "npm run wasm",
    "dev": "vite",
    "prebuild": "npm run wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.12.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^5.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^4.1.11"
  }
}
